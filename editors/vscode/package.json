{
  "name": "abla-language-server",
  "displayName": "Abla Language Server",
  "description": "Compiler-backed navigation, diagnostics, semantic editing, and refactoring for Abla",
  "version": "0.4.0",
  "publisher": "andrebaltazar8",
  "license": "MIT",
  "homepage": "https://abla.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndreBaltazar8/abla-lsp.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:abla",
    "onDebugResolve:abla",
    "onDebugInitialConfigurations",
    "onDebugDynamicConfigurations:abla"
  ],
  "main": "./dist/extension.cjs",
  "extensionDependencies": [
    "andrebaltazar8.abla-tmlanguage"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs && esbuild ../../src/main.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run check && npm run build",
    "package": "npm test && vsce package --no-dependencies"
  },
  "contributes": {
    "breakpoints": [
      {
        "language": "abla"
      }
    ],
    "debuggers": [
      {
        "type": "abla-lldb",
        "label": "Abla (lldb-dap)",
        "languages": [
          "abla"
        ]
      },
      {
        "type": "abla-gdb",
        "label": "Abla (gdb)",
        "languages": [
          "abla"
        ]
      },
      {
        "type": "abla",
        "label": "Abla",
        "languages": [
          "abla"
        ],
        "configurationAttributes": {
          "attach": {
            "properties": {
              "pid": {
                "type": ["number", "string"],
                "description": "The process to attach to."
              },
              "waitFor": {
                "type": "boolean",
                "description": "Wait for a process started from `program` to appear, then attach.",
                "default": false
              },
              "program": {
                "type": "string",
                "description": "The executable (built with `ablac build -g`), so the debugger has the Abla types. It is not built for an attach."
              },
              "initCommands": {
                "type": "array",
                "items": { "type": "string" },
                "description": "More lldb commands to run first (after the Abla summaries)."
              }
            }
          },
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .ab file to debug, or a project directory (abla.toml). It is built with `ablac build -g --fast` first.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for the program.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "The directory the build and the program run in (default: the workspace folder)."
              },
              "output": {
                "type": "string",
                "description": "Where the debug build is written (default: build/debug/<name> in cwd)."
              },
              "env": {
                "type": "object",
                "description": "Environment variables for the program."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the program's entry.",
                "default": false
              },
              "initCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "More lldb commands to run first (after the Abla summaries)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "abla",
            "request": "launch",
            "name": "Debug Abla program",
            "program": "${file}"
          },
          {
            "type": "abla",
            "request": "attach",
            "name": "Attach to Abla program",
            "program": "${workspaceFolder}/build/debug/main",
            "waitFor": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Abla: Launch",
            "description": "Build with debug information and run under lldb-dap.",
            "body": {
              "type": "abla",
              "request": "launch",
              "name": "Debug Abla program",
              "program": "^\"\\${file}\""
            }
          },
          {
            "label": "Abla: Attach",
            "description": "Attach to a running Abla program built with debug information.",
            "body": {
              "type": "abla",
              "request": "attach",
              "name": "Attach to Abla program",
              "program": "^\"\\${workspaceFolder}/build/debug/main\"",
              "waitFor": true
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "abla.runTest",
        "title": "Abla: Run Test"
      },
      {
        "command": "abla.debugTest",
        "title": "Abla: Debug Test"
      },
      {
        "command": "abla.moveDeclarations",
        "title": "Abla: Move Selected Declarations to File"
      },
      {
        "command": "abla.bulkRename",
        "title": "Abla: Rename Symbols at All Cursors"
      },
      {
        "command": "abla.moveTypes",
        "title": "Abla: Move Selected Types to File"
      },
      {
        "command": "abla.splitDeclarations",
        "title": "Abla: Split Selected Declarations into File"
      },
      {
        "command": "abla.mergeDeclarations",
        "title": "Abla: Merge Selected Declarations into File"
      },
      {
        "command": "abla.changeSignature",
        "title": "Abla: Change Function Signature"
      },
      {
        "command": "abla.extractFunction",
        "title": "Abla: Extract Function"
      },
      {
        "command": "abla.functionToMethod",
        "title": "Abla: Convert Function to Method"
      },
      {
        "command": "abla.methodToFunction",
        "title": "Abla: Convert Method to Function"
      },
      {
        "command": "abla.inlineSymbol",
        "title": "Abla: Inline Symbol"
      },
      {
        "command": "abla.introduceLocal",
        "title": "Abla: Introduce Local from Selection"
      },
      {
        "command": "abla.introduceConstant",
        "title": "Abla: Introduce Top-Level Constant from Selection"
      },
      {
        "command": "abla.changeBindingKind",
        "title": "Abla: Change Binding Kind"
      },
      {
        "command": "abla.promoteLocal",
        "title": "Abla: Promote Local"
      },
      {
        "command": "abla.extractInterface",
        "title": "Abla: Extract Interface from Selected Methods"
      },
      {
        "command": "abla.generateDeclaration",
        "title": "Abla: Generate Declaration from Usage"
      },
      {
        "command": "abla.repairOwnership",
        "title": "Abla: Repair Ownership at Selection"
      },
      {
        "command": "abla.makeCompileTime",
        "title": "Abla: Make Function Compile-Time"
      },
      {
        "command": "abla.makeRuntime",
        "title": "Abla: Make Function Runtime"
      },
      {
        "command": "abla.removeDeadCode",
        "title": "Abla: Remove Proven Dead Code"
      },
      {
        "command": "abla.applyRefactorRecipe",
        "title": "Abla: Apply Refactor Recipe"
      },
      {
        "command": "abla.applyStagedRefactorRecipe",
        "title": "Abla: Apply Staged Refactor Recipe"
      }
    ],
    "configuration": {
      "title": "Abla Language Server",
      "properties": {
        "abla.server.path": {
          "type": "string",
          "default": "",
          "description": "Optional path to an external abla-lsp executable. Leave empty to use the language server bundled with this extension."
        },
        "abla.compiler.path": {
          "type": "string",
          "default": "ablac",
          "description": "Path to the ablac executable used for semantic analysis."
        },
        "abla.debug.engine": {
          "type": "string",
          "enum": ["auto", "lldb", "gdb"],
          "default": "auto",
          "description": "The debugger behind the abla debug type: lldb-dap (with Abla value formatters; needs the LLDB DAP extension) or gdb 14+ (DAP mode; frames, breakpoints and stepping, without formatted values). auto prefers lldb-dap."
        },
        "abla.debug.lldbDapPath": {
          "type": "string",
          "default": "",
          "description": "The lldb-dap executable (default: lldb-dap on the PATH). With it, Abla debugging shows arrays by their elements and null optionals as null; without it the LLDB DAP extension's adapter is used."
        },
        "abla.compiler.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use compiler-backed semantic analysis and validated refactoring."
        },
        "abla.compiler.jsonConstruction": {
          "type": "boolean",
          "default": false,
          "description": "Suggest standard JSON literals for clearly recognized hand-built JSON. Requires a compiler with --warn-json-construction."
        },
        "abla.compiler.regexConstruction": {
          "type": "boolean",
          "default": false,
          "description": "Suggest $regex (checked during the build) for regexCompile calls with a literal pattern, with an edit where it is exact. Requires a compiler with --warn-regex-construction."
        },
        "abla.inlayHints.types": {
          "type": "boolean",
          "default": true,
          "description": "Show the inferred type after a local, loop variable or lambda parameter that has no written type (needs the compiler; a binding nothing uses gets no hint)."
        },
        "abla.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace language-server protocol traffic."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  },
  "devDependencies": {
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
