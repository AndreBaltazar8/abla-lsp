{
  "name": "abla-lsp",
  "version": "0.1.0-dev",
  "description": "Compiler-backed language server and refactoring engine for Abla",
  "type": "module",
  "license": "MIT",
  "homepage": "https://abla.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndreBaltazar8/abla-lsp.git"
  },
  "bin": {
    "abla-lsp": "dist/src/main.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test dist/test/*.test.js",
    "validate": "npm test && npm pack --dry-run"
  },
  "dependencies": {
    "vscode-languageserver": "10.1.1",
    "vscode-languageserver-textdocument": "1.0.14"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "7.0.2"
  }
}
